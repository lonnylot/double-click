{
  "name": "dcai-site",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Workers Custom Domain for the live site. Keep this so later deploys
  // do not drop dcai.larehq.com.
  "routes": [{ "pattern": "dcai.larehq.com", "custom_domain": true }]
}
